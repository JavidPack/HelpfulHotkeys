Mods: {
	HelpfulHotkeys: {
		Keybinds: {
			AutoRecall.DisplayName: 自动回家
			AutoTorch.DisplayName: 自动火把
			CycleAmmo.DisplayName: 循环弹药
			QuickStackToChests.DisplayName: 快速堆叠到箱子
			SmartQuickStackToChests.DisplayName: 智能快速堆叠到箱子
			QuickUseItem11.DisplayName: 快速使用物品 #11
			QuickUseItem12.DisplayName: 快速使用物品 #12
			QuickUseItem13.DisplayName: 快速使用物品 #13
			QuickUseItem14.DisplayName: 快速使用物品 #14
			QuickUseItem15.DisplayName: 快速使用物品 #15
			QuickUseItem16.DisplayName: 快速使用物品 #16
			QuickUseItem17.DisplayName: 快速使用物品 #17
			QuickUseItem18.DisplayName: 快速使用物品 #18
			QuickUseItem19.DisplayName: 快速使用物品 #19
			QuickUseItem20.DisplayName: 快速使用物品 #20
			QuickUseConfigItem.DisplayName: 快速使用配置物品
			QuickBuffFavoritedOnly.DisplayName: 快速使用收藏的增益物品
			QueryModOrigin.DisplayName: 查询模组来源
			ToggleAutopause.DisplayName: 开关自动暂停
			SwapArmorWithInventory.DisplayName: 交换盔甲栏与物品栏
			SwapArmorWithVanity.DisplayName: 交换盔甲栏与时装栏
			SwapHotbarWith1stRow.DisplayName: 交换快捷栏与物品栏第一行
			CyclingQuickMount.DisplayName: 循环切换坐骑
			QuickMountHold.DisplayName: 快速坐骑（按住）
			SwitchFrameSkipMode.DisplayName: 切换跳帧模式
			Dash.DisplayName: 冲刺
			ToggleRunInBackground.DisplayName: 切换后台运行
			ToggleRuler.DisplayName: 开关标尺
		}

		Configs: {
			HelpfulHotkeysClientConfig: {
				DisplayName: 配置

				EnableQuickUseItems11to19: {
					Label: 启用快速使用物品 11-19 的快捷键
					Tooltip: 启用后可以使用这些快捷键。禁用后可以保持快捷键菜单整洁。
				}

				SwapArmorInventorySlots: {
					Label: 交换盔甲栏与物品栏的栏位
					Tooltip:
						'''
						在此自定义要交换的盔甲栏与物品栏栏位。
						从 0 开始计数。请输入 0 到 49 之间的数值。
						默认值对应物品栏右下方的栏位。
						'''
				}

				DashHotkeyDisablesDoubleTap: {
					Label: 禁用双击冲刺行为
					Tooltip:
						'''
						启用此选项后，游戏将不会识别双击操作来触发冲刺。
						如果你打算仅使用冲刺快捷键，请启用此选项。
						'''
				}

				DashHotkeyDisabledWhileInChest: {
					Label: 使用箱子时禁用冲刺快捷键
					Tooltip:
						'''
						启用此选项后，在打开箱子时冲刺快捷键将无法使用。
						如果你的冲刺快捷键与箱子操作发生冲突，例如使用 Shift、Alt 或 Ctrl 键时，请启用此选项。
						'''
				}

				QuickUseConfigItem: {
					Label: 快速使用配置物品
					Tooltip:
						'''
						在此自定义快速使用的物品。
						按下快捷键即可从物品栏中快速使用指定的物品。
						'''
				}

				ShowDeveloperInfoQueryModOrigin: {
					Label: 显示开发者信息
					Tooltip:
						'''
						启用后，查询模组来源快捷键还会显示模组物品的内部名称。
						同时也会显示原版物品的 ID。
						'''
				}

				ShowSmartQuickStackToChests: {
					Label: 显示智能存入附近箱子按钮
					Tooltip: 切换是否在[整理物品]按钮旁显示[智能存入附近箱子]按钮
				}
			}
		}
	}
}
